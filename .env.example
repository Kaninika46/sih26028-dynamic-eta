# copy to .env and fill in. Never commit .env
RAILRADAR_KEY=
RAILKIT_KEY=
# sdk = free tier via Node SDK (run: cd sources/node && npm install)
# rest = direct REST (RailKit Advance plan)
RAILKIT_MODE=sdk

# ---- Supabase (login, roles, own database) ----
# Project Settings > API. The publishable/anon key is sent to browsers; the secret/service_role
# key must stay on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
